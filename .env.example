# Copiar a ".env" en el VPS (NUNCA commitear el .env real) y rellenar con valores reales.

# ── Imágenes Docker (las publica el CI en GitHub Container Registry) ──
# Sustituye TU-USUARIO-GITHUB por tu usuario/organización de GitHub (en minúsculas).
IMAGE_API=ghcr.io/tu-usuario-github/cajamenor-api:latest
IMAGE_WEB=ghcr.io/tu-usuario-github/cajamenor-web:latest

# ── Base de datos ──
MSSQL_SA_PASSWORD=CambiaEstaClaveSA_16+chars!
DB_CONNECTION=Server=db;Database=CajaMenorDB;User Id=sa;Password=CambiaEstaClaveSA_16+chars!;TrustServerCertificate=True

# ── JWT (clave >= 32 caracteres) ──
JWT_KEY=GeneraUnaClaveAleatoriaDe32BytesOMas
JWT_ISSUER=https://tu-dominio.com
JWT_AUDIENCE=https://tu-dominio.com

# ── Usuario Maestro y contraseñas de siembra (cambiar los defaults de appsettings) ──
MASTER_ADMIN_USER=maestro@tu-dominio.com
MASTER_ADMIN_PASSWORD=ClaveFuerteDelMaestro!2026
SEEDER_DIRECTOR_PASSWORD=ClaveFuerteDirector!2026
SEEDER_ADMIN_PASSWORD=ClaveFuerteAdmin!2026

# ── Correo (SMTP Gmail con contraseña de aplicación, o el proveedor que uses) ──
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USUARIO=tucuenta@gmail.com
EMAIL_PASSWORD=app-password-de-16-caracteres
EMAIL_REMITENTE=tucuenta@gmail.com
TESORERIA_EMAIL=tesoreria@tu-dominio.com

# ── URLs públicas (dominio real, con https) ──
APP_FRONTEND_URL=https://tu-dominio.com
APP_API_URL=https://tu-dominio.com

# ── OCR Azure Form Recognizer (opcional; si se deja vacío usa Tesseract local) ──
AZURE_FORM_ENDPOINT=
AZURE_FORM_KEY=
