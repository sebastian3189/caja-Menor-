{
  "//": "PRODUCCIÓN: los secretos NUNCA van aquí. Se inyectan por variables de entorno o Key Vault.",
  "//_secretos_requeridos": [
    "ConnectionStrings__DefaultConnection",
    "Jwt__Key  (mínimo 32 caracteres / 256 bits)",
    "Jwt__Issuer",
    "Jwt__Audience",
    "MasterAdmin__User",
    "MasterAdmin__Password  (mínimo 16 caracteres)",
    "Azure__FormRecognizer__Endpoint",
    "Azure__FormRecognizer__Key",
    "Cors__AllowedOrigins__0  (dominio real del frontend, ej. https://cajamenor.tudominio.com)"
  ],
  "Serilog": {
    "MinimumLevel": "Warning"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OCR": {
    "ToleranciaPorc": 5,
    "HabilitarValidacion": true,
    "RechazarSiNoDetecta": true
  },
  "AllowedHosts": "cajamenor.tudominio.com"
}
